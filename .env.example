# ===== AI Wala pipeline settings =====
# Copy this file to ".env" and fill in the values. Don't share .env with anyone.

# --- Gemini (story + voice) — same key you used in the other tool ---
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Voice options to try: Kore, Puck, Charon, Fenrir, Aoede, Leda, Orus, Zephyr
GEMINI_TTS_VOICE=Kore
# urdu = voice reads Urdu script (better pronunciation), roman = voice reads Roman Urdu
VOICE_SCRIPT=urdu

# --- Cloudflare Workers AI (free pictures) ---
CF_ACCOUNT_ID=paste-your-cloudflare-account-id
CF_API_TOKEN=paste-your-cloudflare-api-token

# --- YouTube (same Client ID / Secret as your Google Cloud project) ---
YT_CLIENT_ID=paste-your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=paste-your-client-secret

# private = only you see it | unlisted | public
PRIVACY=private
# Optional: hour (0-23, your PC's time) when the video should go public automatically.
# Example: PUBLISH_AT_HOUR=19 makes it public at 7 PM. Leave empty to use PRIVACY above.
PUBLISH_AT_HOUR=

# --- Video ---
VIDEOS_PER_RUN=1
SCENES=8
BRAND_TEXT=AI WALA
MUSIC_VOLUME=0.10
# Delete old video folders after this many days
KEEP_DAYS=7
